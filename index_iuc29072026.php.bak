session_start();

require_once "db.php";

// ── CSRF Token ────────────────────────────────────────────────
if (empty($_SESSION['csrf_token'])) {
    $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
}

// ── CAPTCHA ───────────────────────────────────────────────────
if (empty($_SESSION['captcha'])) {
    $_SESSION['captcha'] = rand(1000, 9999);
}

// ── Form Handler ─────────────────────────────────────────────
$formSuccess = false;
$formError   = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['contact_submit'])) {

    // CSRF validation
    if (!hash_equals($_SESSION['csrf_token'], $_POST['csrf_token'] ?? '')) {
        $formError = 'Security validation failed. Please refresh and try again.';
    } else {
        $name    = trim($_POST['name']    ?? '');
        $phone   = trim($_POST['phone']   ?? '');
        $email   = trim($_POST['email']   ?? '');
        $course  = trim($_POST['course']  ?? '');
        $message = trim($_POST['message'] ?? '');
        $captcha = trim($_POST['captcha'] ?? '');

        if (!$name || !$phone || !$email || !$course) {
            $formError = 'Please fill in all required fields.';
        } elseif (!filter_var($email, FILTER_VALIDATE_EMAIL)) {
            $formError = 'Please enter a valid email address.';
        } elseif ($captcha != $_SESSION['captcha']) {
            $formError = 'Invalid CAPTCHA. Please try again.';
        } else {
            // Sanitize for DB
            $name_safe    = htmlspecialchars($name);
            $phone_safe   = htmlspecialchars($phone);
            $email_safe   = htmlspecialchars($email);
            $course_safe  = htmlspecialchars($course);
            $message_safe = htmlspecialchars($message);

            $stmt = $conn->prepare("
                INSERT INTO enquiries (full_name, phone, email, course, message)
                VALUES (?, ?, ?, ?, ?)
            ");
            $stmt->bind_param("sssss",
                $name_safe, $phone_safe, $email_safe, $course_safe, $message_safe
            );

            if ($stmt->execute()) {
                // Email notification
                $to      = 'info@iucedu.com';
                $subject = "New Inquiry from {$name_safe} – IUC Computers";
                $body    = "Name: {$name_safe}\nPhone: {$phone_safe}\nEmail: {$email_safe}\nCourse: {$course_safe}\nMessage: {$message_safe}";
                $headers = "From: noreply@iucedu.com\r\nReply-To: {$email_safe}";
                @mail($to, $subject, $body, $headers);

                $formSuccess = true;
                $_SESSION['captcha'] = rand(1000, 9999);
                $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
                $_POST = [];
            } else {
                $formError = 'Something went wrong. Please try again.';
            }
            $stmt->close();
        }
    }
}

