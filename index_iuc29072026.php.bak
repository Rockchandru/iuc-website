    html { -webkit-tap-highlight-color: transparent; scroll-behavior: smooth; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--clr-bg-dark);
      color: var(--clr-text);
      overflow-x: hidden;
      line-height: 1.6;
    }
    ::selection { background: rgba(6,182,212,.3); color: #fff; }

    /* ── Gradient Mesh Backgrounds ── */
    .bg-hero {
      background:
        radial-gradient(ellipse 80% 60% at 15% 25%, rgba(29,78,216,.18) 0%, transparent 60%),
        radial-gradient(ellipse 70% 80% at 85% 75%, rgba(6,182,212,.12) 0%, transparent 60%),
        radial-gradient(ellipse 50% 50% at 50% 50%, rgba(124,58,237,.06) 0%, transparent 70%),
        linear-gradient(160deg, #060d1f 0%, #0f172a 40%, #0a1128 70%, #060d1f 100%);
    }
    .bg-section-dark   { background: var(--clr-bg-dark); }
    .bg-section-deeper { background: var(--clr-bg-deep); }
    .bg-section-mid    { background: var(--clr-bg-mid); }

    /* ── Glassmorphism ── */
    .glass {
      background: rgba(255,255,255,.04);
      backdrop-filter: blur(20px) saturate(1.5);
      -webkit-backdrop-filter: blur(20px) saturate(1.5);
      border: 1px solid var(--clr-border);
    }
    .glass-medium {
      background: rgba(255,255,255,.06);
      backdrop-filter: blur(24px) saturate(1.8);
      -webkit-backdrop-filter: blur(24px) saturate(1.8);
      border: 1px solid rgba(255,255,255,.1);
    }
    .glass-strong {
      background: rgba(255,255,255,.08);
      backdrop-filter: blur(32px) saturate(2);
      -webkit-backdrop-filter: blur(32px) saturate(2);
      border: 1px solid rgba(255,255,255,.14);
    }

    /* ── Typography System ── */
    .text-hero        { font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; }
    .text-section-h   { font-size: clamp(1.75rem, 3vw, 3rem);  font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; }
    .text-subhead     { font-size: clamp(1.25rem, 2vw, 2rem);  font-weight: 600; line-height: 1.3; }
    .text-card-title  { font-size: 1.125rem; font-weight: 600; line-height: 1.4; }
    .grad-text {
      background: linear-gradient(135deg, #60a5fa 0%, #06b6d4 50%, #67e8f9 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .grad-text-warm {
      background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .grad-text-purple {
      background: linear-gradient(135deg, #7c3aed 0%, #06b6d4 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* ── Section Divider ── */
    .section-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 999px;
      background: rgba(6,182,212,.1);
      border: 1px solid rgba(6,182,212,.2);
      color: #67e8f9;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .section-pill-dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #06b6d4;
      animation: pulse-dot 2s ease-in-out infinite;
    }
    @keyframes pulse-dot {
      0%,100% { opacity: 1; transform: scale(1); }
      50%      { opacity: .5; transform: scale(.6); }
    }

    /* ── Gradient Bar ── */
    .grad-bar {
      width: 48px; height: 4px;
      border-radius: 4px;
      background: linear-gradient(90deg, #1d4ed8, #06b6d4);
    }

    /* ── Navbar ── */
    #navbar {
      transition: background var(--transition), box-shadow var(--transition), border-color var(--transition);
      border-bottom: 1px solid transparent;
    }
    #navbar.scrolled {
      background: rgba(6,13,31,.92) !important;
      backdrop-filter: blur(24px) saturate(1.8);
      -webkit-backdrop-filter: blur(24px) saturate(1.8);
      border-bottom-color: rgba(255,255,255,.06);
      box-shadow: 0 4px 30px rgba(0,0,0,.3);
    }
    .nav-link {
      position: relative;
      font-weight: 500;
      font-size: 0.875rem;
      color: #94a3b8;
      transition: color var(--transition);
      padding: 4px 0;
    }
    .nav-link::after {
      content: '';
      position: absolute;
      bottom: -2px; left: 0;
      width: 0; height: 2px;
      background: linear-gradient(90deg, #1d4ed8, #06b6d4);
      border-radius: 2px;
      transition: width var(--transition);
    }
    .nav-link:hover { color: #fff; }
    .nav-link:hover::after { width: 100%; }
    .nav-link.active { color: #fff; }
    .nav-link.active::after { width: 100%; }

    /* ── Dropdown ── */
    .nav-dropdown { position: relative; }
    .nav-dropdown-menu {
      position: absolute;
      top: calc(100% + 12px);
      left: 50%;
      transform: translateX(-50%) translateY(-8px);
      width: 220px;
      background: rgba(6,13,31,.97);
      border: 1px solid rgba(255,255,255,.1);
      border-radius: 16px;
      padding: 8px;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition), transform var(--transition);
      backdrop-filter: blur(24px);
      box-shadow: 0 20px 60px rgba(0,0,0,.5);
      z-index: 100;
    }
    .nav-dropdown:hover .nav-dropdown-menu {
      opacity: 1;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
    .nav-dropdown-item {
      display: block;
      padding: 8px 12px;
      border-radius: 8px;
      color: #94a3b8;
      font-size: 0.8125rem;
      font-weight: 500;
      transition: background var(--transition), color var(--transition);
    }
    .nav-dropdown-item:hover {
      background: rgba(6,182,212,.1);
      color: #06b6d4;
    }

    /* ── Buttons ── */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 700;
      font-size: 0.9375rem;
      border-radius: var(--radius-btn);
      transition: transform var(--transition), box-shadow var(--transition), filter var(--transition), background var(--transition);
      cursor: pointer;
      white-space: nowrap;
    }
    .btn:focus-visible {
      outline: 2px solid #06b6d4;
      outline-offset: 3px;
    }
    .btn-primary {
      background: linear-gradient(135deg, #1d4ed8 0%, #0891b2 100%);
      color: #fff;
      box-shadow: 0 8px 24px rgba(29,78,216,.35);
    }
    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 40px rgba(6,182,212,.4);
      filter: brightness(1.08);
    }
    .btn-primary:active { transform: translateY(0); }
    .btn-secondary {
      background: rgba(255,255,255,.06);
      color: #fff;
      border: 1.5px solid rgba(255,255,255,.15);
    }
    .btn-secondary:hover {
      background: rgba(255,255,255,.1);
      border-color: rgba(255,255,255,.3);
      transform: translateY(-2px);
    }
    .btn-ghost {
      background: transparent;
      color: #06b6d4;
      border: 1.5px solid rgba(6,182,212,.3);
    }
    .btn-ghost:hover {
      background: rgba(6,182,212,.1);
      border-color: #06b6d4;
      transform: translateY(-2px);
    }
    .btn-success {
      background: linear-gradient(135deg, #16a34a, #22c55e);
      color: #fff;
      box-shadow: 0 8px 24px rgba(34,197,94,.3);
    }
    .btn-success:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 40px rgba(34,197,94,.4);
    }
    .btn-sm  { padding: 8px 20px;  font-size: 0.8125rem; }
    .btn-md  { padding: 12px 28px; font-size: 0.9375rem; }
    .btn-lg  { padding: 16px 36px; font-size: 1rem; }
    .btn-xl  { padding: 18px 44px; font-size: 1.0625rem; }

    /* ── Cards ── */
    .card {
      background: linear-gradient(145deg, rgba(30,45,107,.45), rgba(10,17,40,.7));
      border: 1px solid rgba(255,255,255,.07);
      border-radius: var(--radius-card);
      transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
      overflow: hidden;
    }
    .card:hover {
      transform: translateY(-6px);
      box-shadow: 0 30px 80px rgba(0,0,0,.5), 0 0 0 1px rgba(6,182,212,.15);
      border-color: rgba(6,182,212,.2);
    }
    .card-img-wrap { overflow: hidden; }
    .card-img-wrap img { transition: transform .6s cubic-bezier(.4,0,.2,1); }
    .card:hover .card-img-wrap img { transform: scale(1.07); }

    /* ── Stat Cards ── */
    .stat-card {
      background: linear-gradient(135deg,
        rgba(29,78,216,.2) 0%,
        rgba(6,182,212,.08) 100%
      );
      border: 1px solid rgba(6,182,212,.15);
      border-radius: 18px;
      position: relative;
      overflow: hidden;
    }
    .stat-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(6,182,212,.4), transparent);
    }

    /* ── Testimonial Cards ── */
    .testimonial-card {
      background: linear-gradient(145deg, rgba(30,45,107,.4), rgba(10,17,40,.6));
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 20px;
      transition: transform var(--transition), box-shadow var(--transition);
    }
    .testimonial-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 60px rgba(0,0,0,.4);
      border-color: rgba(6,182,212,.15);
    }

    /* ── Pricing Cards ── */
    .pricing-card {
      border-radius: 24px;
      transition: transform var(--transition), box-shadow var(--transition);
    }
    .pricing-card.featured {
      background: linear-gradient(145deg, rgba(29,78,216,.4), rgba(6,182,212,.15));
      border: 1px solid rgba(6,182,212,.3);
      position: relative;
    }
    .pricing-card.featured::before {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: 25px;
      background: linear-gradient(135deg, #1d4ed8, #06b6d4);
      z-index: -1;
    }
    .pricing-card:hover { transform: translateY(-6px); }

    /* ── Feature Items ── */
    .feature-item {
      background: rgba(255,255,255,.03);
      border: 1px solid rgba(255,255,255,.06);
      border-radius: 16px;
      transition: background var(--transition), border-color var(--transition), transform var(--transition);
    }
    .feature-item:hover {
      background: rgba(255,255,255,.06);
      border-color: rgba(6,182,212,.2);
      transform: translateY(-3px);
    }

    /* ── Mentor Cards ── */
    .mentor-card {
      background: linear-gradient(145deg, rgba(30,45,107,.4), rgba(10,17,40,.6));
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 20px;
      transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
    }
    .mentor-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 24px 60px rgba(0,0,0,.4);
      border-color: rgba(6,182,212,.2);
    }

    /* ── Progress Bars ── */
    .progress-track {
      background: rgba(255,255,255,.08);
      border-radius: 999px;
      overflow: hidden;
    }
    .progress-fill {
      height: 6px;
      border-radius: 999px;
      background: linear-gradient(90deg, #1d4ed8, #06b6d4);
      transition: width 1.2s cubic-bezier(.4,0,.2,1);
      width: 0;
    }
    .progress-fill.animated { }

    /* ── Roadmap ── */
    .roadmap-step {
      position: relative;
      padding-left: 48px;
    }
    .roadmap-step::before {
      content: '';
      position: absolute;
      left: 19px;
      top: 48px;
      bottom: -24px;
      width: 2px;
      background: linear-gradient(180deg, #1d4ed8, rgba(6,182,212,.1));
    }
    .roadmap-step:last-child::before { display: none; }
    .roadmap-dot {
      position: absolute;
      left: 0;
      top: 12px;
      width: 40px; height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #1d4ed8, #06b6d4);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 0 4px rgba(29,78,216,.2), 0 0 20px rgba(6,182,212,.3);
      z-index: 1;
    }

    /* ── Curriculum Accordion ── */
    .curriculum-item {
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 14px;
      overflow: hidden;
      transition: border-color var(--transition);
    }
    .curriculum-item:has(details[open]) {
      border-color: rgba(6,182,212,.25);
    }
    .curriculum-item details summary {
      list-style: none;
      cursor: pointer;
    }
    .curriculum-item details summary::-webkit-details-marker { display: none; }
    .curriculum-item details[open] summary .curr-icon {
      transform: rotate(45deg);
      background: linear-gradient(135deg, #06b6d4, #1d4ed8);
      color: #fff;
    }
    .curr-icon {
      transition: transform var(--transition), background var(--transition), color var(--transition);
    }
    .curriculum-item details[open] .curr-body {
      animation: slideDown .3s ease forwards;
    }
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ── FAQ ── */
    .faq-item {
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 16px;
      overflow: hidden;
      transition: border-color var(--transition);
    }
    .faq-item:has(details[open]) { border-color: rgba(6,182,212,.25); }
    .faq-item details summary { list-style: none; cursor: pointer; }
    .faq-item details summary::-webkit-details-marker { display: none; }
    .faq-item details[open] summary .faq-icon {
      transform: rotate(45deg);
      background: linear-gradient(135deg, #06b6d4, #1d4ed8);
      color: #fff;
    }
    .faq-icon { transition: transform var(--transition), background var(--transition), color var(--transition); }
    .faq-item details[open] .faq-body {
      animation: slideDown .3s ease forwards;
    }

    /* ── Form Inputs ── */
    .form-input {
      width: 100%;
      background: rgba(255,255,255,.04);
      border: 1.5px solid rgba(255,255,255,.1);
      border-radius: 12px;
      padding: 14px 18px;
      color: #fff;
      font-size: 0.9375rem;
      font-family: inherit;
      transition: border-color var(--transition), background var(--transition), box-shadow var(--transition);
    }
    .form-input::placeholder { color: #475569; }
    .form-input:focus {
      outline: none;
      border-color: rgba(6,182,212,.5);
      background: rgba(255,255,255,.06);
      box-shadow: 0 0 0 3px rgba(6,182,212,.1);
    }
    .form-input:valid:not(:placeholder-shown) { border-color: rgba(34,197,94,.3); }
    .form-label {
      display: block;
      font-size: 0.75rem;
      font-weight: 600;
      color: #64748b;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    /* ── Animations ── */
    @keyframes float {
      0%,100% { transform: translateY(0); }
      50%      { transform: translateY(-16px); }
    }
    @keyframes float-slow {
      0%,100% { transform: translateY(0) rotate(0deg); }
      50%      { transform: translateY(-12px) rotate(2deg); }
    }
    @keyframes fade-up {
      from { opacity: 0; transform: translateY(32px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes glow-pulse {
      0%,100% { box-shadow: 0 0 20px rgba(6,182,212,.3); }
      50%      { box-shadow: 0 0 50px rgba(6,182,212,.6), 0 0 80px rgba(29,78,216,.3); }
    }
    @keyframes shimmer {
      0%   { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    @keyframes orbit {
      from { transform: rotate(0deg) translateX(80px) rotate(0deg); }
      to   { transform: rotate(360deg) translateX(80px) rotate(-360deg); }
    }
    @keyframes ticker {
      from { transform: translateX(0); }
      to   { transform: translateX(-50%); }
    }

    .animate-float      { animation: float 6s ease-in-out infinite; }
    .animate-float-slow { animation: float-slow 9s ease-in-out infinite; }
    .animate-float-alt  { animation: float-slow 7s ease-in-out infinite reverse; }
    .animate-glow       { animation: glow-pulse 3s ease-in-out infinite; }

    /* ── Scroll Reveal ── */
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity .7s cubic-bezier(.4,0,.2,1), transform .7s cubic-bezier(.4,0,.2,1);
    }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-scale {
      opacity: 0;
      transform: scale(.94);
      transition: opacity .6s ease, transform .6s ease;
    }
    .reveal-scale.visible { opacity: 1; transform: scale(1); }
    .reveal-left {
      opacity: 0;
      transform: translateX(-32px);
      transition: opacity .7s ease, transform .7s ease;
    }
    .reveal-left.visible { opacity: 1; transform: translateX(0); }
    .reveal-right {
      opacity: 0;
      transform: translateX(32px);
      transition: opacity .7s ease, transform .7s ease;
    }
    .reveal-right.visible { opacity: 1; transform: translateX(0); }

    /* Stagger children */
    .stagger > * { transition-delay: calc(var(--i, 0) * 80ms); }

    /* ── Badge ── */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .badge-cyan   { background: rgba(6,182,212,.15);  color: #67e8f9;  border: 1px solid rgba(6,182,212,.2); }
    .badge-green  { background: rgba(34,197,94,.15);  color: #4ade80;  border: 1px solid rgba(34,197,94,.2); }
    .badge-yellow { background: rgba(245,158,11,.15); color: #fbbf24;  border: 1px solid rgba(245,158,11,.2); }
    .badge-red    { background: rgba(239,68,68,.15);  color: #f87171;  border: 1px solid rgba(239,68,68,.2); }
    .badge-purple { background: rgba(124,58,237,.15); color: #a78bfa;  border: 1px solid rgba(124,58,237,.2); }
    .badge-pink   { background: rgba(236,72,153,.15); color: #f472b6;  border: 1px solid rgba(236,72,153,.2); }

    /* ── Tag pills ── */
    .tag {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.6875rem;
      font-weight: 600;
      background: rgba(255,255,255,.06);
      border: 1px solid rgba(255,255,255,.1);
      color: #94a3b8;
      transition: background var(--transition), color var(--transition);
    }
    .tag:hover { background: rgba(6,182,212,.1); color: #06b6d4; }

    /* ── WhatsApp Float ── */
    #wa-float {
      position: fixed;
      bottom: 24px; right: 24px;
      z-index: 999;
      width: 60px; height: 60px;
      border-radius: 50%;
      background: linear-gradient(135deg, #128c7e, #25d366);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 32px rgba(37,211,102,.4);
      transition: transform .25s ease, box-shadow .25s ease;
      animation: glow-pulse 3s ease-in-out infinite;
    }
    #wa-float:hover {
      transform: scale(1.1) translateY(-2px);
      box-shadow: 0 16px 48px rgba(37,211,102,.6);
    }
    #wa-float-tooltip {
      position: absolute;
      right: 72px;
      white-space: nowrap;
      background: rgba(6,13,31,.95);
      border: 1px solid rgba(37,211,102,.3);
      color: #fff;
      font-size: 0.8125rem;
      font-weight: 600;
      padding: 8px 14px;
      border-radius: 10px;
      opacity: 0;
      pointer-events: none;
      transition: opacity .2s ease;
      backdrop-filter: blur(12px);
    }
    #wa-float:hover #wa-float-tooltip { opacity: 1; }

    /* ── Scroll to top ── */
    #scroll-top {
      position: fixed;
      bottom: 96px; right: 24px;
      z-index: 998;
      width: 44px; height: 44px;
      border-radius: 12px;
      background: rgba(29,78,216,.8);
      border: 1px solid rgba(6,182,212,.3);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      opacity: 0;
      transform: translateY(10px);
      transition: opacity .3s ease, transform .3s ease, background .2s ease;
      backdrop-filter: blur(12px);
    }
    #scroll-top.visible { opacity: 1; transform: translateY(0); }
    #scroll-top:hover { background: rgba(6,182,212,.8); }

    /* ── Ticker / Marquee ── */
    .ticker-wrap { overflow: hidden; }
    .ticker-track {
      display: flex;
      width: max-content;
      animation: ticker 30s linear infinite;
    }
    .ticker-track:hover { animation-play-state: paused; }

    /* ── Timeline ── */
    .timeline-connector {
      position: absolute;
      left: 50%;
      top: 0; bottom: 0;
      width: 2px;
      background: linear-gradient(180deg,
        transparent 0%,
        rgba(6,182,212,.4) 20%,
        rgba(29,78,216,.6) 50%,
        rgba(6,182,212,.4) 80%,
        transparent 100%
      );
      transform: translateX(-50%);
    }

    /* ── Loading shimmer skeleton ── */
    .shimmer {
      background: linear-gradient(90deg,
        rgba(255,255,255,.03) 0%,
        rgba(255,255,255,.08) 50%,
        rgba(255,255,255,.03) 100%
      );
      background-size: 200% 100%;
      animation: shimmer 2s ease infinite;
    }

    /* ── Gradient border ── */
    .grad-border {
      position: relative;
      border-radius: 20px;
      padding: 1px;
      background: linear-gradient(135deg, rgba(29,78,216,.5), rgba(6,182,212,.5));
    }
    .grad-border-inner {
      border-radius: 19px;
      background: var(--clr-bg-mid);
    }

    /* ── Highlight box ── */
    .highlight-box {
      background: linear-gradient(135deg, rgba(29,78,216,.15), rgba(6,182,212,.08));
      border: 1px solid rgba(6,182,212,.15);
      border-radius: 16px;
    }

    /* ── Check list ── */
    .check-item::before {
      content: '';
      width: 18px; height: 18px;
      border-radius: 50%;
      background: linear-gradient(135deg, #1d4ed8, #06b6d4);
      flex-shrink: 0;
    }

    /* ── Star rating ── */
    .stars { display: flex; gap: 2px; }
    .stars svg { width: 14px; height: 14px; fill: #f59e0b; }

    /* ── Announcement bar ── */
    .announcement-bar {
      background: linear-gradient(90deg, #1e2d6b, #1d4ed8, #0891b2, #1e2d6b);
      background-size: 300% 100%;
      animation: shimmer 6s linear infinite;
    }

    /* ── Mobile menu ── */
    #mobile-menu {
      max-height: 0;
      overflow: hidden;
      transition: max-height .4s cubic-bezier(.4,0,.2,1), opacity .3s ease;
      opacity: 0;
    }
    #mobile-menu.open {
      max-height: 600px;
      opacity: 1;
    }

    /* ── Orb decorations ── */
    .orb {
      position: absolute;
      border-radius: 50%;
      pointer-events: none;
      filter: blur(60px);
    }

    /* ── Responsive ── */
    @media (max-width: 640px) {
      .text-hero { font-size: 2.25rem; }
      .text-section-h { font-size: 1.625rem; }
    }

    /* ── Custom scrollbar ── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb {
      background: linear-gradient(#1d4ed8, #06b6d4);
      border-radius: 3px;
    }

    /* ── Accessibility: focus visible ── */
    *:focus-visible {
      outline: 2px solid #06b6d4;
      outline-offset: 3px;
    }

    /* ── Print ── */
    @media print {
      #navbar, #wa-float, #scroll-top, .announcement-bar { display: none !important; }
      body { background: #fff; color: #000; }
    }

    /* ── Course card badge position ── */
    .card-badge-wrap { position: relative; }
    .card-badge-abs {
      position: absolute;
      top: 14px; left: 14px;
      z-index: 2;
    }
    .card-badge-live {
      position: absolute;
      top: 14px; right: 14px;
      z-index: 2;
    }

    /* Salary growth indicator */
    .salary-arrow {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: #4ade80;
      font-weight: 700;
      font-size: 0.75rem;
    }
  </style>
</head>
