<!-- ══════════════════════════════════════════════════════════════
     JAVASCRIPT
══════════════════════════════════════════════════════════════ -->
<script>
(function () {
  'use strict';

  /* ── 1. Navbar scroll effect ─────────────────────────────── */
  const navbar = document.getElementById('navbar');
  const onScroll = () => {
    if (window.scrollY > 60) {
      navbar.classList.add('scrolled');
    } else {
      navbar.classList.remove('scrolled');
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();


  /* ── 2. Mobile menu toggle ───────────────────────────────── */
  const hamburger   = document.getElementById('hamburger');
  const mobileMenu  = document.getElementById('mobile-menu');
  const ham1        = document.getElementById('ham-1');
  const ham2        = document.getElementById('ham-2');
  const ham3        = document.getElementById('ham-3');
  let menuOpen      = false;

  hamburger.addEventListener('click', () => {
    menuOpen = !menuOpen;
    hamburger.setAttribute('aria-expanded', menuOpen);
    mobileMenu.classList.toggle('open', menuOpen);

    if (menuOpen) {
      ham1.style.transform = 'translateY(8px) rotate(45deg)';
      ham2.style.opacity   = '0';
      ham3.style.transform = 'translateY(-8px) rotate(-45deg)';
      ham3.style.width     = '20px';
      ham3.style.background = '#fff';
    } else {
      ham1.style.transform = '';
      ham2.style.opacity   = '1';
      ham3.style.transform = '';
      ham3.style.width     = '16px';
      ham3.style.background = '';
    }
  });

  // Close mobile menu when a link is clicked
  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menuOpen = false;
      hamburger.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.remove('open');
      ham1.style.transform = '';
      ham2.style.opacity   = '1';
      ham3.style.transform = '';
      ham3.style.width     = '16px';
      ham3.style.background = '';
    });
  });


  /* ── 3. Active nav link on scroll ───────────────────────── */
  const sections  = document.querySelectorAll('section[id], div[id]');
  const navLinks  = document.querySelectorAll('.nav-link');

  const activateLink = () => {
    let current = '';
    sections.forEach(sec => {
      if (window.scrollY >= sec.offsetTop - 100) current = sec.id;
    });
    navLinks.forEach(link => {
      link.classList.remove('active');
      if (link.getAttribute('href') === '#' + current) {
        link.classList.add('active');
      }
    });
  };
  window.addEventListener('scroll', activateLink, { passive: true });


  /* ── 4. Scroll reveal (Intersection Observer) ────────────── */
  const revealEls = document.querySelectorAll(
    '.reveal, .reveal-scale, .reveal-left, .reveal-right'
  );

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );

  revealEls.forEach(el => revealObserver.observe(el));


  /* ── 5. Counter animation ────────────────────────────────── */
  const counters = document.querySelectorAll('.counter');

  const animateCounter = (el) => {
    const target   = parseInt(el.dataset.target, 10);
    const suffix   = el.textContent.replace(/[0-9]/g, '').trim();
    const duration = 1800;
    const step     = 16;
    const increment = target / (duration / step);
    let current    = 0;

    const timer = setInterval(() => {
      current += increment;
      if (current >= target) {
        current = target;
        clearInterval(timer);
      }
      el.textContent = Math.floor(current).toLocaleString('en-IN') + suffix;
    }, step);
  };

  const counterObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCounter(entry.target);
          counterObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.5 }
  );

  counters.forEach(c => counterObserver.observe(c));


  /* ── 6. Progress bar animation ───────────────────────────── */
  const progressFills = document.querySelectorAll('.progress-fill');

  const progressObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = entry.target.dataset.width || '0';
          entry.target.style.width = target + '%';
          progressObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.3 }
  );

  progressFills.forEach(bar => {
    bar.style.width = '0%';
    progressObserver.observe(bar);
  });


  /* ── 7. Program filter tabs ──────────────────────────────── */
  const tabBtns    = document.querySelectorAll('.tab-btn');
  const programCards = document.querySelectorAll('#programs-grid article');

  const categoryMap = {
    'allprograms'  : null,
    'development'  : ['Full Stack Web Development'],
    'data&ai'      : ['Data Science & AI/ML'],
    'dataai'       : ['Data Science & AI/ML'],
    'security'     : ['Cybersecurity & Ethical Hacking'],
    'cloud'        : ['Cloud Computing (AWS / Azure)'],
    'design'       : ['UI/UX Design & Prototyping'],
    'marketing'    : ['Digital Marketing & SEO'],
  };

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      // Update active state
      tabBtns.forEach(b => {
        b.classList.remove('bg-gradient-to-r', 'from-brand-600', 'to-cyan-DEFAULT', 'text-white', 'border-transparent');
        b.classList.add('text-slate-400', 'border-white/10', 'glass');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('bg-gradient-to-r', 'from-brand-600', 'to-cyan-DEFAULT', 'text-white', 'border-transparent');
      btn.classList.remove('text-slate-400', 'border-white/10', 'glass');
      btn.setAttribute('aria-selected', 'true');

      const tab     = btn.dataset.tab;
      const allowed = categoryMap[tab];

      programCards.forEach(card => {
        if (!allowed) {
          card.style.display = '';
          return;
        }
        const title = card.querySelector('h3') ? card.querySelector('h3').textContent.trim() : '';
        const match = allowed.some(t => title.includes(t));
        card.style.display = match ? '' : 'none';
      });
    });
  });


  /* ── 8. Scroll-to-top button ─────────────────────────────── */
  const scrollTopBtn = document.getElementById('scroll-top');

  window.addEventListener('scroll', () => {
    if (window.scrollY > 400) {
      scrollTopBtn.classList.add('visible');
    } else {
      scrollTopBtn.classList.remove('visible');
    }
  }, { passive: true });


  /* ── 9. Countdown timer ──────────────────────────────────── */
  const countdownTarget = new Date('2025-02-05T09:00:00+05:30').getTime();

  const cdDays = document.getElementById('cd-days');
  const cdHrs  = document.getElementById('cd-hrs');
  const cdMins = document.getElementById('cd-mins');
  const cdSecs = document.getElementById('cd-secs');

  const updateCountdown = () => {
    const now  = Date.now();
    const diff = countdownTarget - now;

    if (diff <= 0) {
      if (cdDays) cdDays.textContent = '00';
      if (cdHrs)  cdHrs.textContent  = '00';
      if (cdMins) cdMins.textContent = '00';
      if (cdSecs) cdSecs.textContent = '00';
      return;
    }

    const days = Math.floor(diff / 86400000);
    const hrs  = Math.floor((diff % 86400000) / 3600000);
    const mins = Math.floor((diff % 3600000)  / 60000);
    const secs = Math.floor((diff % 60000)    / 1000);

    if (cdDays) cdDays.textContent = String(days).padStart(2, '0');
    if (cdHrs)  cdHrs.textContent  = String(hrs).padStart(2, '0');
    if (cdMins) cdMins.textContent = String(mins).padStart(2, '0');
    if (cdSecs) cdSecs.textContent = String(secs).padStart(2, '0');
  };

  updateCountdown();
  setInterval(updateCountdown, 1000);


  /* ── 10. Smooth anchor scroll (offset for fixed navbar) ──── */
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      const target = document.querySelector(this.getAttribute('href'));
      if (!target) return;
      e.preventDefault();
      const offset = 80;
      const top    = target.getBoundingClientRect().top + window.scrollY - offset;
      window.scrollTo({ top, behavior: 'smooth' });
    });
  });


  /* ── 11. Form select color fix ───────────────────────────── */
  const courseSelect = document.getElementById('course');
  if (courseSelect) {
    courseSelect.addEventListener('change', function () {
      this.style.color = this.value ? '#fff' : '#475569';
    });
  }


  /* ── 12. Stagger animation index injection ───────────────── */
  document.querySelectorAll('.stagger > *').forEach((el, i) => {
    el.style.setProperty('--i', i);
  });


  /* ── 13. Curriculum item — only one open at a time ───────── */
  document.querySelectorAll('.curriculum-item details').forEach(detail => {
    detail.addEventListener('toggle', function () {
      if (this.open) {
        document.querySelectorAll('.curriculum-item details').forEach(other => {
          if (other !== this) other.open = false;
        });
      }
    });
  });


  /* ── 14. FAQ item — only one open at a time ──────────────── */
  document.querySelectorAll('.faq-item details').forEach(detail => {
    detail.addEventListener('toggle', function () {
      if (this.open) {
        document.querySelectorAll('.faq-item details').forEach(other => {
          if (other !== this) other.open = false;
        });
      }
    });
  });


  /* ── 15. Google Analytics — form submit event ────────────── */
  const contactForm = document.querySelector('form[method="POST"]');
  if (contactForm) {
    contactForm.addEventListener('submit', () => {
      if (typeof gtag !== 'undefined') {
        gtag('event', 'form_submit', {
          event_category: 'Lead',
          event_label:    'Contact Form',
        });
      }
      if (typeof fbq !== 'undefined') {
        fbq('track', 'Lead');
      }
    });
  }


  /* ── 16. Lazy load images polyfill (native fallback) ────── */
  if ('loading' in HTMLImageElement.prototype === false) {
    document.querySelectorAll('img[loading="lazy"]').forEach(img => {
      img.src = img.src;
    });
  }

})();
</script>

</body>
</html>