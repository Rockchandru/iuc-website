# ══════════════════════════════════════════════════════════
# IUC Edu — Apache Configuration
# ══════════════════════════════════════════════════════════

# Enable Rewrite Engine
RewriteEngine On

# Canonical production host: HTTPS + www. Conditions exclude localhost/XAMPP.
RewriteCond %{HTTP_HOST} ^iucedu\.com$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(?:www\.)?iucedu\.com$ [NC]
RewriteRule ^ https://www.iucedu.com%{REQUEST_URI} [R=301,L,NE]

# Redirect legacy query-string detail URLs to clean canonical URLs.
RewriteCond %{HTTP_HOST} ^(?:www\.)?iucedu\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+.*?course\.php(?:[?\s]) [NC]
RewriteCond %{QUERY_STRING} (?:^|&)slug=([a-z0-9-]+)(?:&|$) [NC]
RewriteRule ^course\.php$ https://www.iucedu.com/course/%1? [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?iucedu\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+.*?blog\.php(?:[?\s]) [NC]
RewriteCond %{QUERY_STRING} (?:^|&)slug=([a-z0-9-]+)(?:&|$) [NC]
RewriteRule ^blog\.php$ https://www.iucedu.com/blog/%1? [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?iucedu\.com$ [NC]
RewriteCond %{THE_REQUEST} \s/+.*?index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ https://www.iucedu.com/ [R=301,L]

# Consolidate the retired public login path into the protected, noindex admin area.
RewriteCond %{HTTP_HOST} ^(?:www\.)?iucedu\.com$ [NC]
RewriteRule ^login(?:/index\.php)?$ https://www.iucedu.com/admin/ [R=301,L,NE]

# Preserve search equity from URLs still present in Google's legacy index.
RewriteCond %{HTTP_HOST} ^(?:www\.)?iucedu\.com$ [NC]
RewriteRule ^contact\.htm$ https://www.iucedu.com/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?iucedu\.com$ [NC]
RewriteRule ^training-courses/Java-training/core-java-training-institute-in-chennai\.htm$ https://www.iucedu.com/course/java [R=301,L,NE,NC]

# Use extensionless URLs without a trailing slash (real directories are exempt).
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s/+(.+?)/[?\s] [NC]
RewriteRule ^(.+)/$ /%1 [R=301,L,NE]

# ── SEO Friendly URLs ────────────────────────────────────

# Course detail pages
RewriteRule ^course/([a-z0-9-]+)$ course.php?slug=$1 [L,QSA,NC]

# Blog detail pages
RewriteRule ^blog/([a-z0-9-]+)$ blog.php?slug=$1 [L,QSA,NC]

# Intent-focused training pages (one substantial page per search intent)
RewriteRule ^(computer-training-in-chennai|programming-courses-in-chennai|it-courses-for-beginners|online-it-courses)$ landing.php?page=$1 [L,QSA,NC]

# Remove .php extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L,QSA]

# ── Security Headers ─────────────────────────────────────
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Caching ──────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ── Compression ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ── Block bad bots ───────────────────────────────────────
RewriteCond %{HTTP_USER_AGENT} libwww-perl [NC,OR]
RewriteCond %{HTTP_USER_AGENT} wget [NC]
RewriteRule ^ - [F,L]

# ── Directory protection ─────────────────────────────────
Options -Indexes
<FilesMatch "(^\.|\.(env|sql|log|ini|json|bak|md|zip)$)">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Custom error pages ───────────────────────────────────
# Serve the project-level 404 page from both a subdirectory and the domain root.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ 404.php [L]

ErrorDocument 404 /404.php

# Redirect 404.php to the correct path if in subdirectory
RewriteCond %{REQUEST_URI} ^/404\.php$ [NC]
RewriteCond %{DOCUMENT_ROOT}/404.php !-f
RewriteRule ^ /iuc-website/404.php [R=302,L]
